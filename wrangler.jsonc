{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calamansi-ui",
  "main": "worker.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calamansi-analytics",
      "database_id": "78937653-7e8c-43cb-9d61-e4a9b268beae"
    }
  ]
}
