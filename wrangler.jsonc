{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calamansi-ui",
  "pages_build_output_dir": "out",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calamansi-analytics",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
